# Required for Azure DevOps API access. Keep this server-side only.
ADO_PAT=

# Optional defaults used to pre-fill the repository selector.
ADO_ORG=
ADO_PROJECT=
ADO_REPO=

# Mutations are disabled by default. Enabling them requires all three ADO_* values above;
# ADO_ORG/ADO_PROJECT/ADO_REPO become the deployment-side mutation allowlist.
ADO_MUTATIONS_ENABLED=false
