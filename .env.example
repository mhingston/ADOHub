# Required for Azure DevOps API access. Keep this server-side only.
ADO_PAT=

# Required organization boundary for ADO writes; also pre-fills the selector.
ADO_ORG=

# Optional defaults used to pre-fill the project/repository selector.
ADO_PROJECT=
ADO_REPO=

# Writes are enabled when ADO_PAT and ADO_ORG are configured. Set this explicitly
# to false to disable all ADO writes.
# ADO_MUTATIONS_ENABLED=false
